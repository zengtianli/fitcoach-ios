# Xcode 派生数据(可重生,别进仓)
.dd*/
DerivedData/
build/
*.xcuserstate
xcuserdata/

# xcodegen 从 project.yml 生成,不进仓 —— 进仓会和 project.yml 打架:
# 改了 yml 忘了重生成,工程和规格就悄悄不一致了。
FitCoach.xcodeproj/

.DS_Store

# 契约对账编出来的二进制,不进仓(源码 ref/main.swift 进仓)。
ref/.contract-bin

# ── PNG 白名单 ────────────────────────────────────────────────────────────────
# git-template 的 info/exclude 默认拦所有 *.png(「大 binary 默认拦截,需要再白名单放回」)。
# 图标是**构建输入**:xcodebuild 调 actool 读它,不进仓则 clone 下来编出来的 app 没图标。
!Resources/Assets.xcassets/AppIcon.appiconset/icon-1024.png
# shots/ 是验收证据,留本地不进仓;要复现:见 README「开发」一节。
shots/

# CC 本地覆盖(可能含机器专属路径/开关),harness audit D6-GITIGNORE 要求
.claude/settings.local.json
*.xcodeproj/
.dd-sim/
.dd-device/
