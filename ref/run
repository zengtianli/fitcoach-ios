#!/bin/bash
# 契约对账：拿 app **自己的** Sources/Models.swift + Sources/API.swift 去打真后端。
# 默认自己起一台干净的本地 fitcoach（临时 DB，跑完删），所以可重复、不脏任何库。
# 打线上/别处：FC_BASE=https://… FC_EMAIL=… FC_PASS=… ./ref/run
set -euo pipefail
cd "$(dirname "$0")/.."
BACKEND="${FITCOACH_TEST_BACKEND:-$(cd ../../service && pwd)}"
TMP=$(mktemp -d)
cleanup() {
  if [ -n "${PID:-}" ]; then kill "$PID" 2>/dev/null || true; wait "$PID" 2>/dev/null || true; fi
  rm -rf "$TMP"
}
trap cleanup EXIT

source $HOME/Dev/tools/dev/lib/tools/macapp/xcode_env.sh
xcode_env_use macosx
xcrun swiftc -O -swift-version 5 \
  Sources/Models.swift Sources/TimeKit.swift Sources/API.swift \
  Sources/WatchSnapshot.swift Sources/WatchLink.swift ref/main.swift \
  -o "$TMP/contract-bin"

if [ -n "${FC_BASE:-}" ]; then
  "$TMP/contract-bin"
  exit
fi

[ -d "$BACKEND" ] || { echo "❌ 找不到后端 $BACKEND —— 无法起本地实例；要打别处请给 FC_BASE" >&2; exit 1; }
PORT=${FC_PORT:-$("$BACKEND/.venv/bin/python" -c 'import socket;s=socket.socket();s.bind(("127.0.0.1",0));print(s.getsockname()[1]);s.close()')}
# fail-closed：端口已被占用就停手。
# 2026-08-27 实测：上一轮遗留的 uvicorn 还占着 8799，新实例起不来，healthz 打到
# **旧那台**上，于是 harness 对着一个陈旧的库全绿。哑掉的守卫和它要防的 bug 同类。
if lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
  echo "❌ 端口 $PORT 已被占用 —— 拒绝在别人的服务器上跑契约对账（换 FC_PORT= 或先杀掉它）" >&2
  lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >&2
  exit 1
fi
# exec makes PID the owned server itself; cleanup never matches other processes.

echo "[ref] 起临时后端 :$PORT （库 $TMP/t.db）"
( cd "$BACKEND" && export FITCOACH_DB="$TMP/t.db" FITCOACH_COACH_AUTH=multi \
    TLZ_GATE_SECRET="$("$BACKEND/.venv/bin/python" -c 'import secrets;print(secrets.token_hex(32))')"; \
    exec "$BACKEND/.venv/bin/python" -m uvicorn api:app --host 127.0.0.1 --port "$PORT" ) > "$TMP/srv.log" 2>&1 &
PID=$!
for _ in $(seq 1 40); do
  curl -sf "http://127.0.0.1:$PORT/healthz" >/dev/null && break
  sleep 0.5
done
curl -sf "http://127.0.0.1:$PORT/healthz" >/dev/null || {
  echo "❌ 后端没起来："; tail -20 "$TMP/srv.log"; exit 1; }

curl -sf -X POST "http://127.0.0.1:$PORT/register" \
  -d "email=t@e.com&password=Passw0rd!234&display_name=T" -o /dev/null || true

FC_BASE="http://127.0.0.1:$PORT" "$TMP/contract-bin"

# 命令行 fitcoach（cli/）编的是同一份 API.swift / Models.swift / QuickSetup.swift：
# 场景测试在它自己的隔离后端上跑（凭证、偏好目录都在临时目录），见 cli/test.sh。
echo
echo "[ref] 命令行场景测试（cli/test.sh）"
bash cli/test.sh

# 手表与 Vision Pro 的便宜编译车道：不起模拟器、不建工程，按 project.yml 的 sources 用 swiftc 类型检查
echo
echo "[ref] watchOS / visionOS 类型检查（Tests/check-platform-typecheck.sh）"
bash Tests/check-platform-typecheck.sh
